{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    // Vite résout les imports comme un bundler, pas comme Node
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
